From 91c0f6de032477b71861d7e0d4fc532470c786f0 Mon Sep 17 00:00:00 2001
From: huanghaiqiang <chris.huang@spacemit.com>
Date: Sat, 18 Jan 2025 16:21:35 +0800
Subject: [PATCH] fix bug: should not exec reboot while processing parameters

---
 init/halt.c | 10 ++++------
 1 file changed, 4 insertions(+), 6 deletions(-)

diff --git a/init/halt.c b/init/halt.c
index 2902b40..aa46014 100644
--- a/init/halt.c
+++ b/init/halt.c
@@ -221,15 +221,13 @@ int halt_main(int argc , char **argv)
 			waitpid(pid, &ret, 0);
 		}
 
-		if(argc == 1)
-			ret = reboot(magic[which]);
-		else
+		if(argc > 1){
 			ret = syscall(SYS_reboot, LINUX_REBOOT_MAGIC1, LINUX_REBOOT_MAGIC2,
 				LINUX_REBOOT_CMD_RESTART2, argv[1]);
-		if (ret < 0) {
-			snprintf(buf, sizeof(buf), "reboot failed: %s\n", strerror(errno));
+			if (ret < 0) {
+				snprintf(buf, sizeof(buf), "reboot failed: %s\n", strerror(errno));
+			}
 		}
-
 	}
 
 	/* Parse and handle arguments */
-- 
2.34.1

